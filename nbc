import numpy as np
import pandas as pd

data = pd.DataFrame({
    "Word_Free": [2,0,1,0,3,0,2,0,1,0,4,0,2,0,3,0,1,0,2,0],
    "Word_Win":  [1,0,2,0,1,0,0,0,1,0,2,0,1,0,2,0,0,0,2,0],
    "Length":    [120,45,150,60,200,50,180,70,160,40,210,55,170,65,190,60,140,50,160,45],
    "Links":     [3,0,4,1,5,0,3,1,4,0,6,0,4,1,5,0,3,1,4,0],
    "Class":     [
        "Spam", "Not_Spam", "Spam", "Not_Spam", "Spam",
        "Not_Spam", "Spam", "Not_Spam", "Spam", "Not_Spam",
        "Spam", "Not_Spam", "Spam", "Not_Spam", "Spam",
        "Not_Spam", "Spam", "Not_Spam", "Spam", "Not_Spam"
    ]
})

features = ["Word_Free", "Word_Win", "Length", "Links"]

def gaussian_probability(x, mean, std):
    return (
        1 / (np.sqrt(2 * np.pi) * std)
    ) * np.exp(
        -((x - mean) ** 2) / (2 * std ** 2)
    )

def naive_bayes_predict(test_data):
    classes = data["Class"].unique()
    probabilities = {}

    for c in classes:
        class_data = data[data["Class"] == c]

        prior = len(class_data) / len(data)

        probability = prior

        for feature in features:
            mean = class_data[feature].mean()
            std = class_data[feature].std()

            value = test_data[feature]

            probability *= gaussian_probability(
                value,
                mean,
                std
            )

        probabilities[c] = probability

    total = sum(probabilities.values())

    for c in probabilities:
        probabilities[c] = probabilities[c] / total

    prediction = max(
        probabilities,
        key=probabilities.get
    )

    return prediction, probabilities


test_data = {
    "Word_Free": 2,
    "Word_Win": 1,
    "Length": 160,
    "Links": 4
}

prediction, probabilities = naive_bayes_predict(test_data)

print("Test Data")
print("-------------------------")
for feature in features:
    print(feature + ":", test_data[feature])

print("\nPosterior Probabilities")
print("-------------------------")

for c, probability in probabilities.items():
    print(c + ":", round(probability, 4))

print("\nPredicted Class:", prediction)
