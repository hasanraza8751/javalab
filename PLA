import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

def sign(x):
    return 1 if x > 0 else -1


def perceptron_learning_algorithm(X, y):
    learning_rate=1.0
    max_epochs=100
    n_samples, n_features = X.shape
    w = np.zeros(n_features)
    b = 0
    for epoch in range(max_epochs):
        print(f"\nEpoch {epoch + 1}")
        error_count = 0
        for i in range(n_samples):
            activation = np.dot(w, X[i]) + b
            y_pred = sign(activation)
            if y_pred != y[i]:
                w +=learning_rate* y[i] * X[i]
                b +=learning_rate* y[i]
                error_count += 1
                print(f" Misclassified sample {i+1}: Update w = {w}, b = {b}")
            else:
                print(f" Correctly classified sample {i+1}")
        if error_count == 0:
            print("No misclassifications, algorithm has converged.")
            print(f" Final w = {w}, and b = {b}")
            break
    return w, b


def plot_decision_boundary(X, y, w, b): # Plot data points
    for label, color in zip([1, -1], ['blue', 'red']):
        class_points = X[y == label]
        plt.scatter(class_points[:, 0], class_points[:, 1], color=color)
    # Plot decision boundary: x2 = -(w1*x1 + b)/w2
    x_vals = np.linspace(np.min(X[:, 0])-1, np.max(X[:, 0])+1, 100)
    if w[1] != 0:
      y_vals = -(w[0] * x_vals + b) / w[1]
      plt.plot(x_vals, y_vals, 'k--', label='Decision Boundary')
    else:
         # vertical line when w[1] = 0
      x_intercept = -b / w[0]
      plt.axvline(x=x_intercept, color='k', linestyle='--', label='Decision Boundary')
    plt.title("Perceptron Classification")
    plt.xlabel("x1")
    plt.ylabel("x2")
    plt.legend()
    plt.grid(True)
    plt.show()


df=pd.read_csv("and_test.csv")
X=df.iloc[:,:-1].values
y=df.iloc[:,-1].values
w, b = perceptron_learning_algorithm(X, y)
plot_decision_boundary(X, y, w, b)
