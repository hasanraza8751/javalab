import numpy as np
from collections import Counter
import matplotlib.pyplot as plt

X = np.array([
    [1.0, 2.0],
    [1.5, 1.8],
    [2.0, 2.2],
    [3.0, 3.0],
    [3.2, 3.5],
    [3.8, 3.0],
    [4.0, 2.5],
    [4.5, 3.2],
    [5.0, 3.0],
    [5.5, 3.5],
    [6.0, 3.0],
    [6.5, 3.5],
    [7.0, 3.0],
    [7.5, 3.5],
    [8.0, 3.0],
    [8.5, 2.8],
    [2.5, 1.5],
    [5.0, 2.0],
    [6.8, 2.5],
    [1.2, 3.0]
])

y = np.array([
    "Red", "Red", "Red", "Red",
    "Blue", "Blue", "Blue", "Blue", "Blue", "Blue",
    "Green", "Green", "Green", "Green", "Green", "Green",
    "Red", "Blue", "Green", "Red"
])

def knn_predict(X, y, test_point, k):
    distances = []

    for i in range(len(X)):
        distance = np.sqrt(
            (test_point[0] - X[i][0]) ** 2 +
            (test_point[1] - X[i][1]) ** 2
        )
        distances.append((distance, y[i]))

    distances.sort()

    nearest_neighbors = distances[:k]

    print("Nearest Neighbors:")
    for distance, label in nearest_neighbors:
        print("Distance:", round(distance, 3), "Label:", label)

    labels = [label for distance, label in nearest_neighbors]

    prediction = Counter(labels).most_common(1)[0][0]

    return prediction


test_point = np.array([4.2, 3.1])
k = 3

prediction = knn_predict(X, y, test_point, k)

print("\nTest Point:", test_point)
print("K =", k)
print("Predicted Class:", prediction)

plt.figure(figsize=(8, 6))

for label in ["Red", "Blue", "Green"]:
    points = X[y == label]
    plt.scatter(points[:, 0], points[:, 1], label=label)

plt.scatter(
    test_point[0],
    test_point[1],
    marker="*",
    s=250,
    label="Test Point"
)

plt.xlabel("X")
plt.ylabel("Y")
plt.title("K-NN Classification")
plt.legend()
plt.grid(True)
plt.show()
