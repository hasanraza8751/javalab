import numpy as np

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

y = np.array([0, 0, 0, 1])

def activation(net):
    if net >= 0:
        return 1
    else:
        return 0

def train_perceptron(X, y, learning_rate=1):
    w1 = 0
    w2 = 0
    b = -1

    while True:
        errors = 0

        for i in range(len(X)):
            x1 = X[i][0]
            x2 = X[i][1]
            d = y[i]

            net = w1 * x1 + w2 * x2 + b
            output = activation(net)

            error = d - output

            if error != 0:
                w1 = w1 + learning_rate * error * x1
                w2 = w2 + learning_rate * error * x2
                b = b + learning_rate * error

                errors += 1

        if errors == 0:
            break

    return w1, w2, b

def test_perceptron(X, w1, w2, b):
    predictions = []

    for i in range(len(X)):
        x1 = X[i][0]
        x2 = X[i][1]

        net = w1 * x1 + w2 * x2 + b
        output = activation(net)

        predictions.append(output)

    return predictions


w1, w2, b = train_perceptron(X, y)

print("Final Weights and Bias")
print("w1 =", w1)
print("w2 =", w2)
print("b  =", b)

predictions = test_perceptron(X, w1, w2, b)

print("\nAND Gate Results")
print("----------------")

for i in range(len(X)):
    print(
        X[i][0],
        "AND",
        X[i][1],
        "=",
        predictions[i]
    )
